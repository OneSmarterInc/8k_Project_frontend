# FE-002: leave empty for local development.
# Requests then go to /api and the Vite dev server proxies them to
# the Django backend (http://127.0.0.1:8000 by default).
#
# Set a full URL only when the frontend is served separately from the
# backend, e.g. VITE_API_BASE_URL=https://watcher.example.com/api
VITE_API_BASE_URL=
